FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisLocalPassword123!
DATABASE_PATH=instance/crm.sqlite3
APP_ENV=development

# Set the aggregator's shared callback secret before exposing the webhook.
USSD_WEBHOOK_TOKEN=
USSD_SHORT_CODE=*123#
REMINDER_CHECK_SECONDS=60

# console previews delivery in the server log; use smtp to send real email.
EMAIL_BACKEND=console
MAIL_FROM=Sign-up Team <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SUPPORT_EMAIL=support@example.com
PUBLIC_BASE_URL=http://localhost:5000

